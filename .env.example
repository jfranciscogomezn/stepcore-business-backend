# Shared PostgreSQL (same database as stepcore-security-backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stepcore_security
DB_USER=gmm_user
DB_PASSWORD=gmm_pass
DB_APP_USER=stepcore_app
DB_APP_PASSWORD=stepcore_app_pass

# JWT (must match stepcore-security-backend)
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production

# Business service port (security uses 8080)
PORT=8081

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
